# Renomeie este arquivo para ".env" ao rodar localmente.
# No Render, essas variáveis devem ser configuradas em
# Settings > Environment do seu Web Service.

# String de conexão do PostgreSQL (fornecida automaticamente pelo Render
# quando você cria um banco e o vincula ao Web Service).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/vendas_orcamentos

# Defina "false" apenas se estiver rodando um Postgres local sem SSL.
PGSSL=true

# Segredo usado para assinar os tokens JWT. Gere um valor aleatório e
# forte em produção (ex: openssl rand -hex 32).
JWT_SECRET=troque-este-valor-por-um-segredo-forte

# Porta em que o servidor Express irá escutar (o Render define
# automaticamente a variável PORT em produção).
PORT=10000

# Usuário administrador criado pelo script de seed (scripts/seed.js).
ADMIN_EMAIL=admin@ferragensw.com.br
ADMIN_PASSWORD=admin123
